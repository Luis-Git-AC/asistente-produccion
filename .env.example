# Clave de la API de Anthropic. Nunca commitear el valor real.
ANTHROPIC_API_KEY=

# Puerto HTTP/SSE del backend (@asistente/server).
PORT=3000

# Puerto del WebSocket bridge hacia el connector de Aseprite.
ASEPRITE_WS_PORT=3001

# Ruta del fichero SQLite de métricas y caché.
DB_PATH=./data/asistente.db

# TTL en segundos de la caché de respuestas del LLM.
CACHE_TTL_SECONDS=86400

# Si es "1", fuerza fallos del modelo primario para demostrar el fallback (claude-opus-5 -> claude-sonnet-5).
SIMULATE_5XX=0
