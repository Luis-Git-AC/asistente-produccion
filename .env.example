# Credencial de Anthropic. Nunca commitear el valor real.
#
# IMPORTANTE: una suscripción de Claude.ai (Pro/Max) NO da acceso a la API.
# Son productos distintos con facturación distinta:
#   - Suscripción -> claude.ai y Claude Code
#   - API         -> api.anthropic.com, se factura desde console.anthropic.com
# Este proyecto llama a la API con el SDK, así que necesita crédito de API.
#
# La clave se crea en: https://console.anthropic.com/settings/keys
#
# Alternativas que el SDK también resuelve, por orden de precedencia:
#   1. ANTHROPIC_API_KEY (esta)
#   2. ANTHROPIC_AUTH_TOKEN (token OAuth de corta duración)
#   3. Un perfil de `ant auth login`
ANTHROPIC_API_KEY=

# Puerto HTTP/SSE del backend (@asistente/server).
PORT=3000

# Puerto del WebSocket bridge hacia el connector de Aseprite.
ASEPRITE_WS_PORT=3001

# Ruta del fichero SQLite de métricas y caché.
DB_PATH=./data/asistente.db

# TTL en segundos de la caché de respuestas del LLM.
CACHE_TTL_SECONDS=86400

# Si es "1", fuerza fallos del modelo primario para demostrar el fallback (claude-opus-5 -> claude-sonnet-5).
SIMULATE_5XX=0
